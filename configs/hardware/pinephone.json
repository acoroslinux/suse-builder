{
  "device": "pinephone",
  "name": "Pine64 PinePhone",
  "arch": "aarch64",
  "soc": "Allwinner A64",
  "packages": [
    "kernel-default",
    "kernel-firmware-all",
    "u-boot-tools",
    "ModemManager",
    "alsa-utils"
  ],
  "kernel_cmdline": "console=tty0 console=ttyS0,115200 earlycon=uart8250,mmio32,0x01c28000 plymouth.enable=0"
}
