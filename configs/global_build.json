{
  "system": {
    "hostname": "opensuse-modern",
    "locale": "en_US.UTF-8",
    "iso_label": "OPENSUSE_MODERN"
  },
  "boot": {
    "kernel_params": "root=live:CDLABEL=OPENSUSE_MODERN rd.live.image rd.live.dir=LiveOS rd.live.squashimg=squashfs.img quiet splash plymouth.enable=1 plymouth.theme=suse-modern"
  },
  "packages": [
    "polkit-gnome",
    "xdg-user-dirs",
    "xdg-user-dirs-gtk",
    "gvfs",
    "gvfs-backends",
    "gvfs-backend-samba",
    "samba",
    "samba-client",
    "avahi",
    "plymouth",
    "plymouth-dracut",
    "plymouth-plugin-script",
    "yast2",
    "yast2-x11",
    "yast2-control-center",
    "yast2-control-center-qt",
    "yast2-packager",
    "yast2-users",
    "yast2-network",
    "yast2-storage-ng",
    "yast2-services-manager",
    "yast2-firewall",
    "yast2-bootloader",
    "yast2-sudo",
    "yast2-firstboot",
    "yast2-auth-client",
    "yast2-ntp-client",
    "yast2-online-update",
    "yast2-samba-client",
    "yast2-samba-server",
    "yast2-scanner",
    "noto-sans-fonts",
    "noto-coloremoji-fonts",
    "nano",
    "vim",
    "neovim",
    "htop",
    "fastfetch"
  ]
}
