{
  "device": "rpi4",
  "name": "Raspberry Pi 4 / 400 / CM4",
  "arch": "aarch64",
  "soc": "Broadcom BCM2711",
  "packages": [
    "kernel-default",
    "raspberrypi-firmware",
    "raspberrypi-firmware-dt",
