{
  "device": "pinephone-pro",
  "name": "Pine64 PinePhone Pro",
  "arch": "aarch64",
  "soc": "Rockchip RK3399",
  "packages": [
    "kernel-default",
    "kernel-firmware-all",
    "u-boot-tools",
    "Mesa-dri",
    "ModemManager",
    "alsa-utils"
