set default=0
set timeout=15
set timeout_style=menu

# Source graphical configuration, fonts and display settings
if [ -f /boot/grub/config.cfg ]; then
    source /boot/grub/config.cfg
elif [ -f /boot/grub2/config.cfg ]; then
    source /boot/grub2/config.cfg
fi

# Main Live Boot Entries for openSUSE
menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Live)' --class opensuse --class gnu-linux --class os --hotkey=l {
    set gfxpayload=keep
    echo 'Loading kernel ...'
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz @@KERNEL_PARAMS@@ vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@
    echo 'Loading initramfs ...'
    initrd /boot/initrd
}

menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Copy to RAM)' --class opensuse --class gnu-linux --class os --hotkey=r {
    set gfxpayload=keep
    echo 'Loading kernel ...'
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz @@KERNEL_PARAMS@@ rd.live.ram=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@
    echo 'Loading initramfs ...'
    initrd /boot/initrd
}

menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Safe Graphics - nomodeset)' --class opensuse --class gnu-linux --class os --hotkey=f {
    set gfxpayload=keep
    echo 'Loading kernel ...'
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz @@KERNEL_PARAMS@@ nomodeset vga=normal fbdev=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@
    echo 'Loading initramfs ...'
    initrd /boot/initrd
}

menuentry 'Verify Boot Media Integrity (Media Check)' --class opensuse --class gnu-linux --class os --hotkey=c {
    set gfxpayload=keep
    echo 'Loading kernel ...'
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz @@KERNEL_PARAMS@@ rd.live.check=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@
    echo 'Loading initramfs ...'
    initrd /boot/initrd
}

menuentry 'Reboot' --class reboot {
    reboot
}

menuentry 'Power Off' --class shutdown {
    halt
}
