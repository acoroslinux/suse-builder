# Load video and graphical modules
# Note: modules are already built-in to the signed grub.efi and our standalone grub.efi
# so we do not insmod them to avoid Secure Boot lockdown errors.


# Load font and setup terminal output
if loadfont /boot/grub2/fonts/unicode.pf2 ; then
    set gfxmode=auto,1024x768,800x600,keep
    set gfxpayload=keep
    terminal_output gfxterm
elif loadfont /boot/grub2/unicode.pf2 ; then
    set gfxmode=auto,1024x768,800x600,keep
    set gfxpayload=keep
    terminal_output gfxterm
elif loadfont /boot/grub/unicode.pf2 ; then
    set gfxmode=auto,1024x768,800x600,keep
    set gfxpayload=keep
    terminal_output gfxterm
fi

# Load openSUSE Modern Live ISO background/theme
if [ -f ($root)/boot/grub2/themes/openSUSE/theme.txt ]; then
    set theme=($root)/boot/grub2/themes/openSUSE/theme.txt
    export theme
elif [ -f ($root)/boot/grub2/themes/suse-modern/suse-grub-bg.jpg ]; then
    background_image -m stretch ($root)/boot/grub2/themes/suse-modern/suse-grub-bg.jpg
fi
