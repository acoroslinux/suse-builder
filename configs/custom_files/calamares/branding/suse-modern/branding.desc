---
componentName:   suse-modern

strings:
    productName:         "openSUSE Modern"
    shortProductName:    "openSUSE Modern"
    version:             "Tumbleweed"
    shortVersion:        "TW"
    versionedName:       "openSUSE Modern Tumbleweed"
    shortVersionedName:  "openSUSE Modern TW"
    installLabel:        "Install openSUSE Modern"
    productUrl:          "https://github.com/acoroslinux/suse-builder"
    supportUrl:          "https://github.com/acoroslinux/suse-builder/issues"
    knownIssuesUrl:      "https://github.com/acoroslinux/suse-builder/issues"
    releaseNotesUrl:     "https://github.com/acoroslinux/suse-builder/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    welcomeImage:        "logo.png"

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true
windowExpanding:    normal
windowSize: 920px,630px
windowPlacement: center

sidebar: qml,bottom
navigation: qml,right

slideshow:               "show.qml"
slideshowAPI:            2

style:
    SidebarBackground:    "#1A1C1E"
    SidebarText:          "#8C92AC"
    SidebarTextCurrent:    "#47A7F5"
    SidebarBackgroundCurrent: "#24292F"
    sidebarBackground:    "#1A1C1E"
    sidebarText:          "#8C92AC"
