---
componentName:   suse-modern

strings:
    productName:         "@@OS_NAME@@"
    shortProductName:    "@@OS_NAME@@"
    version:             "@@VERSION@@"
    shortVersion:        "@@VERSION@@"
    versionedName:       "@@OS_NAME@@ @@VERSION@@"
    shortVersionedName:  "@@OS_NAME@@ @@VERSION@@"
    installLabel:        "Install @@OS_NAME@@"
    productUrl:          "https://github.com/acoroslinux/suse-builder"
    supportUrl:          "https://github.com/acoroslinux/suse-builder/issues"
    knownIssuesUrl:      "https://github.com/acoroslinux/suse-builder/issues"
    releaseNotesUrl:     "https://github.com/acoroslinux/suse-builder/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    welcomeImage:        "logo.png"

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true
windowExpanding:    normal
windowSize: 920px,630px
windowPlacement: center

sidebar: qml,bottom
navigation: qml,right

slideshow:               "show.qml"
slideshowAPI:            2

style:
    SidebarBackground:    "#1A1C1E"
    SidebarText:          "#8C92AC"
    SidebarTextCurrent:    "#47A7F5"
    SidebarBackgroundCurrent: "#24292F"
    sidebarBackground:    "#1A1C1E"
    sidebarText:          "#8C92AC"
    sidebarTextSelect:    "#47A7F5"
    sidebarTextHighlight: "#9E00FF"
