# Set a pure black background fallback
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

# Load the background image
background_image = Image("background.png");

# Scale it to fit the screen
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
resized_bg = background_image.Scale(screen_width, screen_height);
bg_sprite = Sprite(resized_bg);
bg_sprite.SetZ(-100);

# Load the splash (logo) image
splash_image = Image("splash.png");
splash_sprite = Sprite(splash_image);

# Center it
splash_sprite.SetX(Window.GetX() + (Window.GetWidth() / 2 - splash_image.GetWidth() / 2));
splash_sprite.SetY(Window.GetY() + (Window.GetHeight() / 2 - splash_image.GetHeight() / 2));
splash_sprite.SetZ(10);
